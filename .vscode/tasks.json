{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=C:/Navin/Development/vcpkg/scripts/buildsystems/vcpkg.cmake"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project with Debug build type and vcpkg toolchain"
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_TOOLCHAIN_FILE=C:/Navin/Development/vcpkg/scripts/buildsystems/vcpkg.cmake"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project with Release build type and vcpkg toolchain"
        },
        {
            "label": "CMake: Build (Debug)",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "CMake: Configure"
            ],
            "detail": "Build the project using CMake (Debug configuration)"
        },
        {
            "label": "CMake: Build (Release)",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "CMake: Configure (Release)"
            ],
            "detail": "Build the project using CMake (Release configuration)"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean CMake build artifacts"
        },
        {
            "label": "CMake: Rebuild",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Clean",
                "CMake: Build (Debug)"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean and rebuild the project"
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": "${workspaceFolder}/bin/Debug/ZCoreEngine.exe",
            "windows": {
                "command": "${workspaceFolder}/bin/Debug/ZCoreEngine.exe"
            },
            "linux": {
                "command": "${workspaceFolder}/bin/ZCoreEngine"
            },
            "osx": {
                "command": "${workspaceFolder}/bin/ZCoreEngine"
            },
            "options": {
                "cwd": "${workspaceFolder}/bin/Debug"
            },
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "detail": "Run the game executable directly"
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: Build (Debug)",
                "Run Game"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Build and then run the game"
        }
    ]
}
